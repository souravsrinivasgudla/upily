# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_knowledge

# ── LLM ───────────────────────────────────────────────────────────────────────
# Choose "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (alternative) — https://console.anthropic.com
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-haiku-20240307

# ── News ──────────────────────────────────────────────────────────────────────
# Free tier at https://newsapi.org (500 req/day)
# Leave blank to use RSS feeds instead
NEWS_API_KEY=

# ── Web Search ────────────────────────────────────────────────────────────────
# Serper.dev — 2500 free queries/month — https://serper.dev
# Leave blank to fall back to DuckDuckGo instant answers
SERPER_API_KEY=

# ── Scheduler ─────────────────────────────────────────────────────────────────
DAILY_FETCH_HOUR=6
DAILY_FETCH_MINUTE=0

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_ARTICLES_PER_RUN=50
