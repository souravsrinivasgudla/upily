# ─────────────────────────────────────────────────────────────────────────────
# Upily backend configuration. Copy to `.env` and fill in what you need.
# Only an LLM key is needed for AI features; news works with zero keys (RSS).
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
# Browser origins allowed to call the API directly (comma-separated).
# Local dev (Vite proxy) doesn't need this. In production the frontend calls the API
# directly, so this MUST include your Vercel URL, e.g. https://upily.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: leave unset to use SQLite at backend/upily.db
# Production: use Postgres (e.g. Neon free tier — https://neon.tech). Plain
# postgres:// / postgresql:// URLs with ?sslmode=require are converted for asyncpg.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── LLM (required for AI analysis, chat and trending topics) ─────────────────
# groq | openai | anthropic
LLM_PROVIDER=groq
# Optional — defaults: groq=openai/gpt-oss-120b, openai=gpt-4o-mini,
# anthropic=claude-haiku-4-5-20251001
# LLM_MODEL=
# Reasoning effort for gpt-oss models on Groq: low | medium | high
# LLM_REASONING_EFFORT=low
# https://console.groq.com/keys (free tier)
GROQ_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── News sources (optional — top up RSS when feeds are thin) ─────────────────
# https://gnews.io (100 req/day free) — also powers Trending
GNEWS_API_KEY=
# https://newsapi.org (free tier is dev-only / localhost)
NEWS_API_KEY=
# https://serpapi.com (100 searches/month free) — Trending
SERPAPI_API_KEY=

# ── Web search for chat (optional — DuckDuckGo is used when unset) ──────────
# https://serper.dev
SERPER_API_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
# Long random string. Enables POST /api/admin/pipeline and PATCH /api/news/{id}/enrich
# (send it as the X-Admin-Token header). Leave empty to disable those endpoints.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ── Pipeline tuning (defaults shown) ─────────────────────────────────────────
# FETCH_INTERVAL_HOURS=4
# RUN_PIPELINE_ON_STARTUP=true
# FRESHNESS_HOURS=24
# RETENTION_HOURS=48
# ARTICLES_PER_CATEGORY=6
# MAX_STORED_PER_CATEGORY=30
# REFRESH_COOLDOWN_SECONDS=300
